# Database configuration
# For MongoDB:
MONGODB_URI="mongodb://username:password@localhost:27017/finance?authSource=admin"

# Plaid API configuration (get from https://dashboard.plaid.com)
PLAID_CLIENT_ID="your_plaid_client_id_here"
PLAID_SECRET="your_plaid_secret_here"
PLAID_ENV="sandbox"

# Encryption configuration
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY="generate_a_64_character_hex_string_here"

# Security configuration
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="generate_a_64_character_hex_string_here"
NEXTAUTH_URL="http://localhost:3000"

# Session configuration
SESSION_COOKIE_NAME="finance_monitor_session"
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE="lax"
SESSION_COOKIE_MAX_AGE=86400

# Optional: Federal Reserve Economic Data API (for live rates)
# Get free key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY="your_fred_api_key_here"
